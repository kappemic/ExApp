{
  "name": "exapp",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "sync": "tsx scripts/sync-readmodel.ts",
    "prebuild": "npm run sync",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "server:dev": "tsx watch server/src/index.ts",
    "server:start": "tsx server/src/index.ts",
    "server:typecheck": "tsc -p server --noEmit",
    "server:build": "tsc -p server --noEmit false --outDir dist-server --rootDir . --module commonjs",
    "postserver:build": "node -e \"require('fs').writeFileSync('dist-server/package.json', '{\\n  \\\"type\\\": \\\"commonjs\\\"\\n}')\"",
    "smoke:3b": "tsx scripts/smoke-3b.ts",
    "smoke:faze2": "tsx scripts/smoke-faze2.ts",
    "smoke:faze3": "tsx scripts/smoke-faze3.ts",
    "smoke:faze4": "tsx scripts/smoke-faze4.ts",
    "smoke:faze5-discord": "tsx scripts/smoke-faze5-discord.ts",
    "over-strava": "tsx scripts/over-strava.ts",
    "seed:test-uzivatele": "tsx scripts/seed-test-uzivatele.ts",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kappemic/ExApp.git"
  },
  "keywords": [],
  "type": "module",
  "bugs": {
    "url": "https://github.com/kappemic/ExApp/issues"
  },
  "homepage": "https://github.com/kappemic/ExApp#readme",
  "dependencies": {
